# CRM Tizimi konfiguratsiyasi

# Xavfsizlik kaliti (JWT uchun)
SECRET_KEY=crm-secret-key-super-secure-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server sozlamalari
PORT=8000
HOST=0.0.0.0

# Telegram Bot sozlamalari (@BotFather dan olingan token)
