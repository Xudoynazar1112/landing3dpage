TELEGRAM_BOT_TOKEN=9036371278:AAGMmn0Ur8NbJpgQSDhPAjOEo09HVZhoPPM

# Telegram Web App URL manzili (masalan: https://yourdomain.com yoki ngrok havolasi)
WEBAPP_URL=http://localhost:8000

# SQLite ma'lumotlar bazasi manzili
DATABASE_URL=sqlite+aiosqlite:///./crm.db

