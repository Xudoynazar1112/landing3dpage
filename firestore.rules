rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Hardened Primitives
    // ---------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Zero-DB-read verified bootstrap admin check (safe for list queries & anti-spoofing)
    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'saparovxudoynazar@gmail.com';
    }

    // Single-document admin check (bootstrap admin OR registered admin doc)
    function isAdmin() {
      return isBootstrapAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidSpecialty(val) {
      return val is string && val.size() <= 24 && val in ['epilepsy', 'autism', 'sleep', 'developmental', 'migraine', 'adhd'];
    }

    function isValidDateStr(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTimeStr(val) {
      return val is string && val.size() == 5 && val.matches('^[0-2][0-9]:[0-5][0-9]$');
    }

    // ---------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap)
    // ---------------------------------------------------------
    function isValidBooking(data) {
      return data.keys().hasAll([
          'code', 'parentName', 'phone', 'childAge', 'specialtyId',
          'format', 'date', 'timeSlot', 'notes', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'code', 'parentName', 'phone', 'childAge', 'specialtyId',
          'format', 'date', 'timeSlot', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && data.code is string && data.code.size() >= 6 && data.code.size() <= 24 && data.code.matches('^DZ-[0-9]{6}$')
        && data.parentName is string && data.parentName.size() >= 2 && data.parentName.size() <= 120
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 32
        && data.childAge is string && data.childAge.size() >= 1 && data.childAge.size() <= 40
        && isValidSpecialty(data.specialtyId)
        && data.format is string && data.format.size() <= 16 && data.format in ['clinic', 'online']
        && isValidDateStr(data.date)
        && data.timeSlot is string && data.timeSlot.size() >= 3 && data.timeSlot.size() <= 24
        && data.notes is string && data.notes.size() <= 800
        && data.status is string && data.status.size() <= 20 && data.status in ['new', 'contacted', 'confirmed', 'converted', 'cancelled']
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidOffsetList(arr) {
      return arr is list
        && arr.size() <= 4
        && (arr.size() == 0 || (arr[0] is int && arr[0] >= 5 && arr[0] <= 1440));
    }

    function isValidOperation(data) {
      return data.keys().hasAll([
          'patientName', 'parentPhone', 'childAge', 'procedureTitle', 'category',
          'specialtyId', 'date', 'startTime', 'durationMinutes', 'room',
          'priority', 'status', 'notes', 'remindBeforeMinutes', 'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'patientName', 'parentPhone', 'childAge', 'procedureTitle', 'category',
          'specialtyId', 'date', 'startTime', 'durationMinutes', 'room',
          'priority', 'status', 'notes', 'remindBeforeMinutes', 'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.patientName is string && data.patientName.size() >= 2 && data.patientName.size() <= 120
        && data.parentPhone is string && data.parentPhone.size() >= 7 && data.parentPhone.size() <= 32
        && data.childAge is string && data.childAge.size() >= 1 && data.childAge.size() <= 40
        && data.procedureTitle is string && data.procedureTitle.size() >= 2 && data.procedureTitle.size() <= 160
        && data.category is string && data.category.size() <= 24 && data.category in ['operation', 'video_eeg', 'rehabilitation', 'consultation']
        && isValidSpecialty(data.specialtyId)
        && isValidDateStr(data.date)
        && isValidTimeStr(data.startTime)
        && data.durationMinutes is int && data.durationMinutes >= 10 && data.durationMinutes <= 480
        && data.room is string && data.room.size() >= 1 && data.room.size() <= 60
        && data.priority is string && data.priority.size() <= 16 && data.priority in ['routine', 'urgent', 'critical']
        && data.status is string && data.status.size() <= 20 && data.status in ['scheduled', 'preparing', 'completed', 'cancelled']
        && data.notes is string && data.notes.size() <= 1000
        && isValidOffsetList(data.remindBeforeMinutes)
        && isValidId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCrmSettings(data) {
      return data.keys().hasAll([
          'dailyBriefingTime', 'eveningPreviewTime', 'weeklyDigestDay',
          'dailyRemindersEnabled', 'preOpOffsets', 'timezone', 'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'dailyBriefingTime', 'eveningPreviewTime', 'weeklyDigestDay',
          'dailyRemindersEnabled', 'preOpOffsets', 'timezone', 'updatedBy', 'updatedAt'
        ])
        && isValidTimeStr(data.dailyBriefingTime)
        && isValidTimeStr(data.eveningPreviewTime)
        && data.weeklyDigestDay is int && data.weeklyDigestDay >= 0 && data.weeklyDigestDay <= 6
        && data.dailyRemindersEnabled is bool
        && isValidOffsetList(data.preOpOffsets)
        && data.timezone is string && data.timezone.size() >= 3 && data.timezone.size() <= 40
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.role is string && data.role.size() <= 24 && data.role == 'doctor_admin'
        && data.createdAt is timestamp;
    }

    // ---------------------------------------------------------
    // Collection: /bookings/{bookingId}
    // Public create-only with strict schema; PII strictly Admin-only to read/manage
    // ---------------------------------------------------------
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isAdmin();
      allow list: if isBootstrapAdmin();

      allow create: if isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().status == 'new'
        && incoming().createdAt == request.time
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time);

      allow update: if isValidId(bookingId)
        && isValidBooking(incoming())
        && isAdmin()
        && incoming().code == existing().code
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update pipeline status & clinical triage notes
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])) ||
          // Action 2: Reschedule appointment slot
          (incoming().diff(existing()).affectedKeys().hasOnly(['date', 'timeSlot', 'format', 'status', 'notes', 'updatedAt']))
        );

      allow delete: if isValidId(bookingId) && isAdmin();
    }

    // ---------------------------------------------------------
    // Collection: /operations/{operationId}
    // Doctor daily & weekly surgical/clinical calendar (strictly Admin-only)
    // ---------------------------------------------------------
    match /operations/{operationId} {
      allow get: if isValidId(operationId) && isAdmin();
      allow list: if isBootstrapAdmin();

      allow create: if isValidId(operationId)
        && isValidOperation(incoming())
        && isAdmin()
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(operationId)
        && isValidOperation(incoming())
        && isAdmin()
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Status & prep transition (with admin override for terminal states)
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])) ||
          // Action 2: Full schedule/procedure edit by doctor admin
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'patientName', 'parentPhone', 'childAge', 'procedureTitle', 'category',
            'specialtyId', 'date', 'startTime', 'durationMinutes', 'room',
            'priority', 'status', 'notes', 'remindBeforeMinutes', 'updatedAt'
          ]))
        );

      allow delete: if isValidId(operationId) && isAdmin();
    }

    // ---------------------------------------------------------
    // Collection: /crm_settings/{settingId}
    // Non-secret Telegram daily/weekly reminder preferences (Admin-only)
    // ---------------------------------------------------------
    match /crm_settings/{settingId} {
      allow get: if isValidId(settingId) && isAdmin();
      allow list: if isBootstrapAdmin();

      allow create: if isValidId(settingId)
        && isValidCrmSettings(incoming())
        && isAdmin()
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;

      allow update: if isValidId(settingId)
        && isValidCrmSettings(incoming())
        && isAdmin()
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'dailyBriefingTime', 'eveningPreviewTime', 'weeklyDigestDay',
          'dailyRemindersEnabled', 'preOpOffsets', 'timezone', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // ---------------------------------------------------------
    // Collection: /admins/{adminUid}
    // Locked admin registry (bootstrap admin only)
    // ---------------------------------------------------------
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isBootstrapAdmin() || (isVerifiedUser() && request.auth.uid == adminUid));
      allow list: if isBootstrapAdmin();
      allow create: if isValidId(adminUid) && isValidAdminUser(incoming()) && isBootstrapAdmin() && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminUid) && isBootstrapAdmin();
    }
  }
}
